{% if nifi_registry_container_labels_traefik_enabled %}
traefik.enable=true

{% if nifi_registry_container_labels_traefik_docker_network %}
traefik.docker.network={{ nifi_registry_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if nifi_registry_container_labels_traefik_basic_auth_enabled %}
traefik.http.middlewares.{{ nifi_registry_identifier }}-basic-auth.basicauth.users={{ nifi_registry_container_labels_traefik_basic_auth_users | join(',') }}
traefik.http.middlewares.{{ nifi_registry_identifier }}-basic-auth.basicauth.realm={{ nifi_registry_identifier }}
traefik.http.middlewares.{{ nifi_registry_identifier }}-basic-auth.basicauth.removeheader=true
{% set middlewares = middlewares + [nifi_registry_identifier + '-basic-auth'] %}
{% endif %}

{% if nifi_registry_container_labels_traefik_root_redirect_enabled %}
traefik.http.middlewares.{{ nifi_registry_identifier }}-root-redirect.redirectregex.regex=^(https?://[^/]+)/?$
traefik.http.middlewares.{{ nifi_registry_identifier }}-root-redirect.redirectregex.replacement=${1}/nifi-registry/
{% set middlewares = middlewares + [nifi_registry_identifier + '-root-redirect'] %}
{% endif %}

{% if nifi_registry_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in nifi_registry_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ nifi_registry_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [nifi_registry_identifier + '-add-request-headers'] %}
{% endif %}

{% if nifi_registry_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in nifi_registry_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ nifi_registry_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [nifi_registry_identifier + '-add-response-headers'] %}
{% endif %}

{% set middlewares = middlewares + nifi_registry_container_labels_traefik_additional_middlewares %}

traefik.http.routers.{{ nifi_registry_identifier }}.rule={{ nifi_registry_container_labels_traefik_rule }}
{% if nifi_registry_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ nifi_registry_identifier }}.priority={{ nifi_registry_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ nifi_registry_identifier }}.service={{ nifi_registry_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ nifi_registry_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ nifi_registry_identifier }}.entrypoints={{ nifi_registry_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ nifi_registry_identifier }}.tls={{ nifi_registry_container_labels_traefik_tls | to_json }}
{% if nifi_registry_container_labels_traefik_tls %}
traefik.http.routers.{{ nifi_registry_identifier }}.tls.certResolver={{ nifi_registry_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ nifi_registry_identifier }}.loadbalancer.server.port={{ nifi_registry_container_http_port }}
{% endif %}

{% for arg in nifi_registry_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
